# ==============================================================================
# AI-Based Framework for Security Risk Evaluation in Multi-Cloud Environments
# Environment Variables Template (.env.example)
# ==============================================================================
# Instructions: Copy this file to .env and configure your variables.
# NEVER commit the actual .env file or credentials to version control.
# ==============================================================================

# Core Operating Mode (Set to true for offline demo mode with synthetic data)
DEMO_MODE=true
DATABASE_URL=sqlite:///backend/app/cloud_security.db

# Amazon Web Services (AWS)
AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Microsoft Azure
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=

# Google Cloud Platform (GCP)
GOOGLE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-service-account.json

# Oracle Cloud Infrastructure (OCI)
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=credentials/oci_api_key.pem
OCI_REGION=us-ashburn-1

# Optional Supporting Services (Decoupled / Non-blocking)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
