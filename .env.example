# ==============================================================================
# CLOUD SECURITY ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to .env and fill in the values.
# DO NOT commit the .env file containing actual secrets to source control.
# ==============================================================================

# --- APPLICATION CORE ---
# Set to 'false' in production to enforce secret validation, live billing, and cloud checks.
# If 'true', the platform runs in offline Demo Mode using SQLite and local mocks.
DEMO_MODE=true

# --- DATABASE CONFIGURATION ---
# Local database defaults to SQLite. In production (DEMO_MODE=false), set to a PostgreSQL URI.
DATABASE_URL=sqlite:///backend/app/cloud_security.db

# --- SUPABASE PRODUCTION AUTH ---
# Required for user session verification and RBAC checks when DEMO_MODE=false.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-key-used-for-token-decoding

# --- RAZORPAY BILLING PIPELINE ---
# Required for live payment processing and cryptographic webhook upgrades.
RAZORPAY_KEY_ID=rzp_test_or_live_key
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-used-to-verify-callbacks

# --- MULTI-CLOUD INTEGRATIONS LAYER ---
# Note: Cloud connectors default to read-only unless specifically configured.

# AWS Connector Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Microsoft Azure Connector Configuration
AZURE_CLIENT_ID=your-azure-service-principal-client-id
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_CLIENT_SECRET=your-azure-service-principal-client-secret

# Google Cloud Platform Connector Configuration
GOOGLE_PROJECT_ID=your-gcp-project-id
# Path to local secure JSON key file on the server (do not commit json files).
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-service-account-credentials.json

# Oracle Cloud Infrastructure Connector Configuration
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your-tenancy-ocid
OCI_USER_OCID=ocid1.user.oc1..your-user-ocid
OCI_FINGERPRINT=your-api-key-fingerprint
# Path to local private PEM key file on the server (do not commit pem keys).
OCI_PRIVATE_KEY_PATH=path/to/oci_api_key.pem
OCI_REGION=us-ashburn-1
